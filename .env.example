# Copy to .env for local development. Do NOT commit real secrets.

# ---------------------------------------------------------------------------
# Database (REQUIRED — the app refuses to boot without it)
# ---------------------------------------------------------------------------
# PostgreSQL only. The migration history is Postgres-dialect SQL; SQLite/MySQL are NOT supported.
# `docker compose up -d db` starts a matching local instance.
DATABASE_URL="postgresql://easycrm:easycrm@localhost:5432/easycrm?schema=public"

# ---------------------------------------------------------------------------
# Secrets (REQUIRED)
# ---------------------------------------------------------------------------
# 32-byte secret for AES-256-GCM encryption of the Brevo BYOK API key (hex or base64).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-with-64-hex-characters"

# ---------------------------------------------------------------------------
# Shopify (provided by the CLI during `shopify app dev`; set explicitly in production)
# ---------------------------------------------------------------------------
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_APP_URL=
# SCOPES=read_customers,read_orders,read_locations

# ---------------------------------------------------------------------------
# Background worker (optional)
# ---------------------------------------------------------------------------
# The worker runs in-process alongside the web server by default. Set to "false" to disable it
# on a given instance. Requires a long-running process (the Dockerfile target) — it will not
# drain reliably on freeze-between-requests serverless platforms.
# RUN_JOB_WORKER=true
# How many jobs one worker claims per tick, and how often it polls (ms).
# JOB_WORKER_BATCH=5
# JOB_WORKER_INTERVAL_MS=2000

# ---------------------------------------------------------------------------
# Observability (optional but strongly recommended in production)
# ---------------------------------------------------------------------------
# Sentry DSN. When unset, error reporting degrades to structured console logging.
# SENTRY_DSN=
# LOG_LEVEL=info   # debug | info | warn | error
