// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// DATASOURCE (see DECISIONS.md §2):
//   - PostgreSQL is the only supported datasource, for dev and production alike. The migration
//     history is Postgres-dialect SQL and is NOT portable to SQLite/MySQL — do not switch the
//     provider without regenerating `prisma/migrations/` from scratch.
//   - Local dev uses a Postgres container (see README "Local setup").
//
// CONVENTIONS:
//   - No native `enum` types — "enum" fields are String + a TS union defined in
//     app/lib/crm/constants.ts. Allowed values are documented at each field.
//   - JSON columns are String (store JSON.stringify) — see Activity.payload, Segment.criteria.
//   - `String` maps to Postgres `text` (unbounded), so long note bodies are safe.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Shopify session storage (scaffold model — do not remove)
// ---------------------------------------------------------------------------
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ---------------------------------------------------------------------------
// CRM models — every record is tenant-scoped by `shop` (shop domain) and indexed.
// ---------------------------------------------------------------------------

/// Read-mirror of a Shopify customer plus CRM augmentation.
model Contact {
  id                String @id @default(cuid())
  shop              String
  shopifyCustomerId String // Shopify customer GID, e.g. "gid://shopify/Customer/123"

  // Cached fields mirrored from Shopify for fast list/search/sort/filter.
  firstName String?
  lastName  String?
  email     String?
  phone     String?

  // Lightweight cached spend signals (see DECISIONS.md §3) — for list filter/sort only.
  // `amountSpent` is a non-authoritative Float cache key so the list can sort/filter spend
  // numerically; the authoritative money value is fetched live on the detail page.
  amountSpent         Float     @default(0)
  currencyCode        String?
  ordersCount         Int       @default(0)
  lastOrderAt         DateTime?
  lastVisitAt         DateTime?
  lastVisitLocationId String?

  // CRM augmentation.
  lifecycleStage String  @default("LEAD") // LEAD | PROSPECT | CUSTOMER | VIP | CHURNED (configurable)
  ownerStaffId   String?
  source         String?

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tags             ContactTag[]
  notes            Note[]
  activities       Activity[]
  tasks            Task[]
  processedOrders  ProcessedOrder[]
  visits           Visit[]
  contactLocations ContactLocation[]
  preferences      ContactPreference[]

  @@unique([shop, shopifyCustomerId])
  @@index([shop])
  @@index([shop, lifecycleStage])
  @@index([shop, email])
  @@index([shop, phone])
  @@index([shop, amountSpent])
  @@index([shop, lastVisitAt])
  @@index([shop, updatedAt])
}

model Tag {
  id        String       @id @default(cuid())
  shop      String
  name      String
  createdAt DateTime     @default(now())
  contacts  ContactTag[]

  @@unique([shop, name])
  @@index([shop])
}

model ContactTag {
  contactId String
  tagId     String
  shop      String
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
  @@index([shop])
}

model Note {
  id            String   @id @default(cuid())
  shop          String
  contactId     String
  body          String
  authorStaffId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([shop, contactId])
}

/// Timeline event. `type` is one of ActivityType (see constants). `payload` is JSON-as-String.
model Activity {
  id         String   @id @default(cuid())
  shop       String
  contactId  String
  type       String // NOTE | ORDER_PLACED | STAGE_CHANGED | TASK | OUTREACH_* | SYSTEM
  payload    String? // JSON.stringify(...) — see app/lib/crm/activity helpers
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([shop, contactId, occurredAt])
  @@index([shop, occurredAt])
}

model Task {
  id              String    @id @default(cuid())
  shop            String
  contactId       String? // nullable — standalone tasks allowed
  title           String
  notes           String?
  dueAt           DateTime?
  status          String    @default("OPEN") // OPEN | DONE
  assigneeStaffId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([shop, status, dueAt])
  @@index([shop, contactId])
}

/// Saved list filter/view. `criteria` is JSON-as-String describing the filter.
model Segment {
  id        String   @id @default(cuid())
  shop      String
  name      String
  criteria  String // JSON.stringify(ContactFilter)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, name])
  @@index([shop])
}

/// Durable background job queue (see DECISIONS.md §11). Deliberately DB-backed rather than
/// Redis-backed so the app needs no infrastructure beyond Postgres. Claimed with an optimistic
/// compare-and-set on `status`, so multiple app instances can run workers safely.
model Job {
  id     String @id @default(cuid())
  shop   String
  type   String // BACKFILL_CUSTOMERS | BACKFILL_ORDERS
  status String @default("PENDING") // PENDING | RUNNING | DONE | FAILED

  payload String // JSON.stringify(...) — shape depends on `type`

  /// Optional caller-supplied idempotency key. A second enqueue with the same key is a no-op,
  /// which is what makes "retry the whole batch" safe.
  dedupeKey String?

  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, dedupeKey])
  /// The worker's claim query: oldest runnable job first.
  @@index([status, runAt])
  @@index([shop, type, status])
}

/// Dedup ledger for order webhooks: an atomic, exact-match idempotency lock keyed by order GID.
/// The unique (shop, orderGid) constraint makes concurrent orders/create + orders/paid deliveries
/// of the same order safe (only the first insert wins) — see DECISIONS.md §3.
model ProcessedOrder {
  id           String    @id @default(cuid())
  shop         String
  orderGid     String
  contactId    String
  orderName    String?
  total        String?
  currencyCode String?
  occurredAt   DateTime?
  sourceName   String?
  locationId   String?
  posUserId    String?
  posDeviceId  String?
  lineItems    String? // JSON.stringify([{ title, quantity, variantTitle, sku, productId }])
  createdAt    DateTime  @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([shop, orderGid])
  @@index([shop])
  @@index([shop, contactId])
  @@index([shop, occurredAt])
}

/// Read-mirror of a Shopify store location. `legacyId` joins order webhook `location_id` values.
model Location {
  id                 String   @id @default(cuid())
  shop               String
  shopifyLocationGid String
  legacyId           String
  name               String
  isActive           Boolean  @default(true)
  city               String?
  provinceCode       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([shop, legacyId])
  @@index([shop])
}

/// One customer visit per store-local calendar day, inferred from an attributed POS order.
model Visit {
  id         String   @id @default(cuid())
  shop       String
  contactId  String
  locationId String
  visitDate  String // YYYY-MM-DD in the shop's IANA timezone
  source     String   @default("POS_ORDER") // POS_ORDER
  orderGid   String?
  createdAt  DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([shop, contactId, locationId, visitDate])
  @@index([shop, visitDate])
  @@index([shop, locationId, visitDate])
  @@index([shop, contactId])
}

/// Per-contact order rollup by Shopify location legacy id.
model ContactLocation {
  contactId   String
  shop        String
  locationId  String
  ordersCount Int       @default(0)
  lastOrderAt DateTime?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([contactId, locationId])
  @@index([shop, locationId])
}

/// App-owned customer preferences. Phase 4 adds derivation and manual-edit behavior.
model ContactPreference {
  id          String   @id @default(cuid())
  shop        String
  contactId   String
  key         String // SHIRT_SIZE | SHOE_SIZE
  value       String
  source      String // DERIVED | MANUAL
  sampleCount Int      @default(0)
  updatedAt   DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, key, source])
  @@index([shop, contactId])
}

/// Minimal Shopify staff mirror for later staff-to-home-location assignment.
model StaffProfile {
  id             String   @id @default(cuid())
  shop           String
  staffId        String
  displayName    String?
  homeLocationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([shop, staffId])
}

/// A `customers/data_request` GDPR/CCPA export, held for the merchant to retrieve.
///
/// Shopify provides no callback for data requests — the merchant is responsible for delivering
/// the data to the customer, and has 30 days to do it. Logging the payload (the previous
/// behavior) left them with nothing to deliver, so the obligation went unmet. See DECISIONS.md §14.
model DataRequest {
  id                String    @id @default(cuid())
  shop              String
  shopifyCustomerId String
  customerEmail     String?
  /// JSON.stringify of the assembled CRM export for this customer.
  payload           String
  status            String    @default("OPEN") // OPEN | RESOLVED
  /// Set when a staff member marks the request as fulfilled.
  resolvedAt        DateTime?
  resolvedByStaffId String?

  createdAt DateTime @default(now())

  @@index([shop, createdAt])
  @@index([shop, status])
}

model ShopSettings {
  id   String @id @default(cuid())
  shop String @unique

  // Optional override of lifecycle stages (JSON-as-String array). Null => defaults.
  lifecycleStages String?

  // Shop calendar timezone used to bucket POS visits into unambiguous YYYY-MM-DD strings.
  ianaTimezone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
