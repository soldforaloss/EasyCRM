// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// DATASOURCE (see DECISIONS.md §2):
//   - PostgreSQL is the only supported datasource, for dev and production alike. The migration
//     history is Postgres-dialect SQL and is NOT portable to SQLite/MySQL — do not switch the
//     provider without regenerating `prisma/migrations/` from scratch.
//   - Local dev uses a Postgres container (see README "Local setup").
//
// CONVENTIONS:
//   - No native `enum` types — "enum" fields are String + a TS union defined in
//     app/lib/crm/constants.ts. Allowed values are documented at each field.
//   - JSON columns are String (store JSON.stringify) — see Activity.payload, Segment.criteria.
//   - `String` maps to Postgres `text` (unbounded), so long note/message bodies are safe.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Shopify session storage (scaffold model — do not remove)
// ---------------------------------------------------------------------------
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ---------------------------------------------------------------------------
// CRM models — every record is tenant-scoped by `shop` (shop domain) and indexed.
// ---------------------------------------------------------------------------

/// Read-mirror of a Shopify customer plus CRM augmentation.
model Contact {
  id                String   @id @default(cuid())
  shop              String
  shopifyCustomerId String // Shopify customer GID, e.g. "gid://shopify/Customer/123"

  // Cached fields mirrored from Shopify for fast list/search/sort/filter.
  firstName String?
  lastName  String?
  email     String?
  phone     String?

  // Marketing consent, mirrored from Shopify and ENFORCED at send time (see DECISIONS.md §10).
  // Values are Shopify's CustomerEmailMarketingState / CustomerSmsMarketingState:
  //   SUBSCRIBED | NOT_SUBSCRIBED | PENDING | UNSUBSCRIBED | REDACTED | INVALID
  // NULL means "never synced" and is treated as NOT consented — fail closed.
  emailMarketingState String?
  smsMarketingState   String?

  // Lightweight cached spend signals (see DECISIONS.md §3) — for list filter/sort only.
  // `amountSpent` is a non-authoritative Float cache key so the list can sort/filter spend
  // numerically; the authoritative money value is fetched live on the detail page.
  amountSpent  Float    @default(0)
  currencyCode String?
  ordersCount  Int      @default(0)
  lastOrderAt  DateTime?

  // CRM augmentation.
  lifecycleStage String  @default("LEAD") // LEAD | PROSPECT | CUSTOMER | VIP | CHURNED (configurable)
  ownerStaffId   String?
  source         String?

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tags        ContactTag[]
  notes       Note[]
  activities  Activity[]
  tasks       Task[]
  messageLogs MessageLog[]

  @@unique([shop, shopifyCustomerId])
  @@index([shop])
  @@index([shop, lifecycleStage])
  @@index([shop, email])
  @@index([shop, phone])
  @@index([shop, amountSpent])
  @@index([shop, updatedAt])
}

model Tag {
  id        String       @id @default(cuid())
  shop      String
  name      String
  createdAt DateTime     @default(now())
  contacts  ContactTag[]

  @@unique([shop, name])
  @@index([shop])
}

model ContactTag {
  contactId String
  tagId     String
  shop      String
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
  @@index([shop])
}

model Note {
  id            String   @id @default(cuid())
  shop          String
  contactId     String
  body          String
  authorStaffId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([shop, contactId])
}

/// Timeline event. `type` is one of ActivityType (see constants). `payload` is JSON-as-String.
model Activity {
  id         String   @id @default(cuid())
  shop       String
  contactId  String
  type       String // NOTE | EMAIL_SENT | SMS_SENT | ORDER_PLACED | STAGE_CHANGED | TASK | SYSTEM
  payload    String? // JSON.stringify(...) — see app/lib/crm/activity helpers
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([shop, contactId, occurredAt])
  @@index([shop, occurredAt])
}

model Task {
  id             String    @id @default(cuid())
  shop           String
  contactId      String? // nullable — standalone tasks allowed
  title          String
  notes          String?
  dueAt          DateTime?
  status         String    @default("OPEN") // OPEN | DONE
  assigneeStaffId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([shop, status, dueAt])
  @@index([shop, contactId])
}

/// Saved list filter/view. `criteria` is JSON-as-String describing the filter.
model Segment {
  id        String   @id @default(cuid())
  shop      String
  name      String
  criteria  String // JSON.stringify(ContactFilter)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, name])
  @@index([shop])
}

model MessageTemplate {
  id        String   @id @default(cuid())
  shop      String
  name      String
  channel   String // EMAIL | SMS
  subject   String? // email only
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messageLogs MessageLog[]

  @@index([shop, channel])
}

model MessageLog {
  id                String   @id @default(cuid())
  shop              String
  contactId         String
  channel           String // EMAIL | SMS
  direction         String   @default("OUTBOUND") // OUTBOUND | INBOUND
  templateId        String?
  subject           String?
  bodySnapshot      String
  status            String   @default("QUEUED") // QUEUED | SENT | FAILED | SKIPPED (outbound only; ignored for inbound)
  /// Reason a send was suppressed without being attempted (status = SKIPPED). One of
  /// SkipReason in constants.ts: NO_CONSENT | NO_ADDRESS | INVALID_PHONE.
  skipReason        String?
  /// Set when this row belongs to a bulk send, so progress can be aggregated per batch.
  batchId           String?
  providerMessageId String? // Brevo id for OUR outbound send
  // Brevo Conversations per-message id for INBOUND dedup. Null for outbound rows; engines treat
  // NULLs as distinct in unique indexes, so many outbound NULLs coexist (DECISIONS.md §2).
  providerEventId   String?
  error             String?
  sentByStaffId     String?
  createdAt         DateTime @default(now())

  contact  Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  template MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  batch    MessageBatch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([shop, providerEventId])
  /// One row per (batch, contact) — the idempotency guard that makes a retried bulk-send job
  /// unable to double-send. NULLs are distinct, so non-bulk rows are unconstrained.
  @@unique([batchId, contactId])
  @@index([shop, contactId])
  @@index([shop, createdAt])
  @@index([batchId])
}

/// A bulk send. Recipients are fanned out into one Job per contact; this row aggregates progress
/// so the UI can poll a single record. See DECISIONS.md §11.
model MessageBatch {
  id               String   @id @default(cuid())
  shop             String
  channel          String // EMAIL | SMS
  subject          String?
  body             String
  templateId       String?
  createdByStaffId String?
  /// Human label for the recipient source, e.g. `segment "VIPs"` or "42 selected contact(s)".
  label            String?

  total   Int @default(0)
  sent    Int @default(0)
  failed  Int @default(0)
  skipped Int @default(0)

  status    String   @default("RUNNING") // RUNNING | DONE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messageLogs MessageLog[]

  @@index([shop, createdAt])
}

/// Durable background job queue (see DECISIONS.md §11). Deliberately DB-backed rather than
/// Redis-backed so the app needs no infrastructure beyond Postgres. Claimed with an optimistic
/// compare-and-set on `status`, so multiple app instances can run workers safely.
model Job {
  id     String @id @default(cuid())
  shop   String
  type   String // SEND_ONE | BACKFILL_CUSTOMERS
  status String @default("PENDING") // PENDING | RUNNING | DONE | FAILED

  payload String // JSON.stringify(...) — shape depends on `type`

  /// Optional caller-supplied idempotency key. A second enqueue with the same key is a no-op,
  /// which is what makes "retry the whole batch" safe.
  dedupeKey String?

  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  runAt       DateTime @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, dedupeKey])
  /// The worker's claim query: oldest runnable job first.
  @@index([status, runAt])
  @@index([shop, type, status])
}

/// Dedup ledger for order webhooks: an atomic, exact-match idempotency lock keyed by order GID.
/// The unique (shop, orderGid) constraint makes concurrent orders/create + orders/paid deliveries
/// of the same order safe (only the first insert wins) — see DECISIONS.md §3.
model ProcessedOrder {
  id        String   @id @default(cuid())
  shop      String
  orderGid  String
  contactId String
  createdAt DateTime @default(now())

  @@unique([shop, orderGid])
  @@index([shop])
}

/// A `customers/data_request` GDPR/CCPA export, held for the merchant to retrieve.
///
/// Shopify provides no callback for data requests — the merchant is responsible for delivering
/// the data to the customer, and has 30 days to do it. Logging the payload (the previous
/// behavior) left them with nothing to deliver, so the obligation went unmet. See DECISIONS.md §14.
model DataRequest {
  id                String  @id @default(cuid())
  shop              String
  shopifyCustomerId String
  customerEmail     String?
  /// JSON.stringify of the assembled CRM export for this customer.
  payload           String
  status            String  @default("OPEN") // OPEN | RESOLVED
  /// Set when a staff member marks the request as fulfilled.
  resolvedAt        DateTime?
  resolvedByStaffId String?

  createdAt DateTime @default(now())

  @@index([shop, createdAt])
  @@index([shop, status])
}

model ShopSettings {
  id   String @id @default(cuid())
  shop String @unique

  // Brevo BYOK — ciphertext only (AES-256-GCM "iv:tag:ciphertext" base64 bundle). Never plaintext.
  brevoApiKeyEncrypted String?
  brevoConnected       Boolean @default(false)
  brevoAccountEmail    String? // validated account email, for display only
  brevoSenderEmail     String?
  brevoSenderName      String?
  brevoSmsSender       String?

  // --- Marketing compliance (see DECISIONS.md §10) ---
  // CAN-SPAM requires a valid physical postal address in every marketing email, and a working
  // opt-out mechanism. Marketing email sends are BLOCKED until `businessAddress` is set.
  businessAddress String?
  /// Merchant-hosted unsubscribe page. When null, the footer falls back to a mailto: opt-out
  /// addressed to the configured sender.
  unsubscribeUrl  String?

  // Inbound (two-way) messaging via Brevo Conversations webhooks. The token is the secret in the
  // per-shop webhook URL (capability URL); the optional secret is an extra basic-auth check,
  // encrypted at rest like the API key. See DECISIONS.md §5 + §9.
  brevoInboundToken  String? @unique
  brevoInboundSecret String?

  // Optional override of lifecycle stages (JSON-as-String array). Null => defaults.
  lifecycleStages String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
